{
  "manifest_version": 3,
  "name": "Медиапульт для Stream Dock",
  "version": "1.1.0",
  "description": "Управление аудио и видео во вкладках браузера с панели Stream Dock.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "media.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Медиапульт для Stream Dock",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon.png"
  }
}
